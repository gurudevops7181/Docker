version: "3"
services:
  web:
    image: httpd
    ports:
      - "80:80"
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        fluentd-async-connect: "true"
        tag: httpd.access
  nginx:
    image: sreeharshav/efknginx:v1
    ports:
      - "8000:80"
    logging:
      driver: "fluentd"
      options:
        fluentd-address: localhost:24224
        fluentd-async-connect: "true"
        tag: nginx.access

  fluentd:
    image: sreeharshav/efk_fluentd:v2
    volumes:
      - ./fluentd/fluentd.conf:/fluentd/etc/fluent.conf:ro
    depends_on:
      - elasticsearch
    restart: unless-stopped
    ports:
      - "24224:24224"
      - "24224:24224/udp"

  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:9.5.5
    environment:
      discovery.type: single-node
      xpack.security.enabled: "false"
    expose:
      - "9200"
    ports:
      - "127.0.0.1:9200:9200"
    volumes:
      - data01:/usr/share/elasticsearch/data

  kibana:
    image: docker.elastic.co/kibana/kibana:9.5.5
    ports:
      - "127.0.0.1:5601:5601"

volumes:
   data01:
    driver: local
